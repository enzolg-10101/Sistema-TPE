<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="900.0"
            style="-fx-background-color: #F3F4F6; -fx-font-family: 'Segoe UI', 'Inter', sans-serif;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controlador.VehiculoController">

    <center>
        <StackPane>

            <!-- ========================================================================= -->
            <!-- VISTA 1: GALERÍA DE VEHÍCULOS CON SCROLLPANE Y TILEPANE                   -->
            <!-- ========================================================================= -->
            <VBox fx:id="vistaGaleria" spacing="20.0">
                <padding>
                    <Insets bottom="24.0" left="28.0" right="28.0" top="22.0"/>
                </padding>

                <!-- Panel superior con título, desplegable por tipo, buscador rápido y botón 'Nuevo Vehículo' -->
                <HBox alignment="CENTER_LEFT" spacing="14.0"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 16; -fx-border-color: #E5E7EB; -fx-border-radius: 16; -fx-padding: 18 24 18 24;">
                    <VBox spacing="2.0">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label fx:id="lblTituloGaleria"
                                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;"
                                   text="Flota de Vehículos"/>
                            <Button fx:id="btnLimpiarFiltroSucursal" managed="false" onAction="#quitarFiltroSucursal" prefHeight="28.0" visible="false"
                                    style="-fx-background-color: #FEF3C7; -fx-text-fill: #D97706; -fx-border-color: #FDE68A; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 11.5px; -fx-font-weight: bold; -fx-padding: 0 10 0 10; -fx-cursor: hand;"
                                    text="✕ Ver todas las sucursales"/>
                        </HBox>
                        <Label fx:id="lblCantidadVehiculos"
                               style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"
                               text="0 vehículos en flota · Haga clic en un vehículo para ver su ficha completa"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <ComboBox fx:id="cmbFiltroTipo" prefHeight="40.0" prefWidth="165.0"
                              promptText="Tipo: Todos"
                              style="-fx-background-color: #F3F4F6; -fx-background-radius: 10; -fx-border-color: transparent; -fx-font-size: 13px; -fx-cursor: hand;"/>

                    <TextField fx:id="txtBuscarVehiculo" prefWidth="250.0"
                               promptText="Filtrar por marca, modelo o patente..."
                               style="-fx-background-color: #F3F4F6; -fx-background-radius: 10; -fx-border-color: transparent; -fx-padding: 10 14 10 14; -fx-font-size: 13px;"/>

                    <Button onAction="#mostrarVistaAlta" prefHeight="40.0"
                            style="-fx-background-color: #262626; -fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 0 20 0 20; -fx-cursor: hand;"
                            text="Nuevo Vehículo"/>
                </HBox>

                <!-- ScrollPane central con TilePane para mostrar los vehículos en formato grilla -->
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                            style="-fx-background: #F3F4F6; -fx-background-color: transparent; -fx-border-color: transparent;">
                    <content>
                        <TilePane fx:id="contenedorVehiculos" hgap="20.0" prefColumns="3" vgap="20.0"
                                  style="-fx-background-color: #F3F4F6; -fx-padding: 4;">
                        </TilePane>
                    </content>
                </ScrollPane>
            </VBox>

            <!-- ========================================================================= -->
            <!-- VISTA 2: FICHA COMPLETA DEL VEHÍCULO SELECCIONADO (EDITOR)                -->
            <!-- ========================================================================= -->
            <VBox fx:id="vistaDetalle" managed="false" spacing="18.0" visible="false">
                <padding>
                    <Insets bottom="24.0" left="28.0" right="28.0" top="22.0"/>
                </padding>

                <!-- Barra superior de navegación de la ficha -->
                <HBox alignment="CENTER_LEFT" spacing="14.0"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 16; -fx-border-color: #E5E7EB; -fx-border-radius: 16; -fx-padding: 16 24 16 24;">
                    <Button onAction="#volverAGaleriaDesdeDetalle" prefHeight="36.0"
                            style="-fx-background-color: #F3F4F6; -fx-text-fill: #111827; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 0 14 0 14; -fx-cursor: hand;"
                            text="← Volver a Vehículos"/>

                    <VBox spacing="2.0">
                        <Label fx:id="lblFichaTitulo"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;"
                               text="Ficha Técnica del Vehículo"/>
                        <Label fx:id="lblFichaSubtitulo"
                               style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"
                               text="Información completa de la unidad registrada en la flota"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label fx:id="lblDetalleBadgeDisponibilidad"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #15803D; -fx-background-color: #DCFCE7; -fx-border-color: #86EFAC; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 6 14 6 14;"
                           text="● Disponible"/>
                </HBox>

                <!-- Contenido principal: Tarjeta izquierda con foto y resumen + Tarjeta derecha con todos los atributos -->
                <HBox spacing="20.0" VBox.vgrow="ALWAYS">

                    <!-- Tarjeta Izquierda: Imagen y Resumen Destacado -->
                    <VBox alignment="TOP_LEFT" prefWidth="265.0" spacing="12.0"
                          style="-fx-background-color: #FFFFFF; -fx-background-radius: 16; -fx-border-color: #E5E7EB; -fx-border-radius: 16; -fx-padding: 20;">
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #9CA3AF;"
                                   text="UNIDAD EN FLOTA"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblDetalleCatBadge"
                                   style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #D97706; -fx-background-color: #FEF3C7; -fx-background-radius: 6; -fx-padding: 3 10 3 10;"
                                   text="Auto"/>
                        </HBox>

                        <StackPane prefHeight="155.0"
                                   style="-fx-background-color: #F9FAFB; -fx-background-radius: 12; -fx-padding: 10;">
                            <ImageView fx:id="imgDetalleVehiculo" fitHeight="135.0" fitWidth="215.0" preserveRatio="true"/>
                        </StackPane>

                        <Label fx:id="lblDetalleMarcaModelo" wrapText="true"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;"
                               text="Marca Modelo"/>

                        <Label fx:id="lblDetallePatenteBadge"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151; -fx-background-color: #F3F4F6; -fx-background-radius: 8; -fx-padding: 5 12 5 12;"
                               text="Patente: -"/>

                        <Separator/>

                        <VBox spacing="3.0">
                            <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6B7280;"
                                   text="TARIFA BASE DIARIA"/>
                            <Label fx:id="lblDetalleTarifaDestacada"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #D97706;"
                                   text="\$0.00 / día"/>
                        </VBox>

                        <VBox spacing="3.0"
                              style="-fx-background-color: #F9FAFB; -fx-background-radius: 10; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-padding: 10 12 10 12;">
                            <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6B7280;"
                                   text="SUCURSAL PERTENECIENTE"/>
                            <Label fx:id="lblDetalleSucursalDestacada" wrapText="true"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #111827;"
                                   text="-"/>
                        </VBox>
                    </VBox>

                    <!-- Tarjeta Derecha: Grilla Completa con TODOS los atributos del vehículo -->
                    <VBox spacing="14.0" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #FFFFFF; -fx-background-radius: 16; -fx-border-color: #E5E7EB; -fx-border-radius: 16; -fx-padding: 22 24 22 24;">

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label fx:id="lblTituloDatosDetalle"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;"
                                   text="Datos Registrados del Vehículo"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnEditarDetalle" onAction="#habilitarEdicionDetalle" prefHeight="36.0"
                                    style="-fx-background-color: #111827; -fx-text-fill: #FFFFFF; -fx-font-size: 12.5px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 0 16 0 16; -fx-cursor: hand;"
                                    text="✎ Editar Vehículo"/>
                        </HBox>

                        <Separator/>

                        <GridPane hgap="16.0" vgap="12.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
                            </columnConstraints>

                            <!-- Fila 0: ID (Solo lectura), Patente, Marca, Modelo -->
                            <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #6B7280;" text="ID Vehículo (V_id)"/>
                                <TextField fx:id="txtDetId" editable="false" style="-fx-background-color: #E5E7EB; -fx-background-radius: 8; -fx-padding: 8 10 8 10; -fx-font-weight: bold; -fx-text-fill: #4B5563;"/>
                            </VBox>

                            <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Patente (V_pat)"/>
                                <TextField fx:id="txtDetPat" editable="false" style="-fx-background-color: #F3F4F6; -fx-background-radius: 8; -fx-padding: 8 10 8 10; -fx-font-weight: bold;"/>
                            </VBox>

                            <VBox spacing="4.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <Label style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Marca (V_marca)"/>
                                <TextField fx:id="txtDetMarca" editable="false" style="-fx-background-color: #F3F4F6; -fx-background-radius: 8; -fx-padding: 8 10 8 10;"/>
                            </VBox>

                            <VBox spacing="4.0" GridPane.columnIndex="3" GridPane.rowIndex="0">
                                <Label style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Modelo (V_mod)"/>
                                <TextField fx:id="txtDetMod" editable="false" style="-fx-background-color: #F3F4F6; -fx-background-radius: 8; -fx-padding: 8 10 8 10;"/>
                            </VBox>

                            <!-- Fila 1: Año Fabr., Categoría, Tipo Combustible, Transmisión -->
                            <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Año Fabr. (V_aFabr)"/>
                                <ComboBox fx:id="cmbDetAFabr" focusTraversable="false" maxWidth="Infinity" mouseTransparent="true" style="-fx-background-color: #F3F4F6; -fx-background-radius: 8;"/>
                            </VBox>

                            <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Categoría (T_cat)"/>
                                <ComboBox fx:id="cmbDetCat" focusTraversable="false" maxWidth="Infinity" mouseTransparent="true" style="-fx-background-color: #F3F4F6; -fx-background-radius: 8;"/>
                            </VBox>

                            <VBox spacing="4.0" GridPane.columnIndex="2" GridPane.rowIndex="1">
                                <Label style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Combustible (V_tiComb)"/>
                                <ComboBox fx:id="cmbDetTiComb" focusTraversable="false" maxWidth="Infinity" mouseTransparent="true" style="-fx-background-color: #F3F4F6; -fx-background-radius: 8;"/>
                            </VBox>

                            <VBox spacing="4.0" GridPane.columnIndex="3" GridPane.rowIndex="1">
                                <Label style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Transmisión (V_tran)"/>
                                <ComboBox fx:id="cmbDetTransmision" focusTraversable="false" maxWidth="Infinity" mouseTransparent="true" style="-fx-background-color: #F3F4F6; -fx-background-radius: 8;"/>
                            </VBox>

                            <!-- Fila 2: Kilometraje, Capacidad de Carga, Pasajeros, Tarifa Base -->
                            <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                <Label style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Kilometraje (V_kmj)"/>
                                <TextField fx:id="txtDetKmj" editable="false" style="-fx-background-color: #F3F4F6; -fx-background-radius: 8; -fx-padding: 8 10 8 10;"/>
                            </VBox>

                            <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                <Label style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Cap. Carga en kg (T_carga)"/>
                                <TextField fx:id="txtDetCarga" editable="false" style="-fx-background-color: #F3F4F6; -fx-background-radius: 8; -fx-padding: 8 10 8 10;"/>
                            </VBox>

                            <VBox spacing="4.0" GridPane.columnIndex="2" GridPane.rowIndex="2">
                                <Label style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Pasajeros (T_pax)"/>
                                <TextField fx:id="txtDetPax" editable="false" style="-fx-background-color: #F3F4F6; -fx-background-radius: 8; -fx-padding: 8 10 8 10;"/>
                            </VBox>

                            <VBox spacing="4.0" GridPane.columnIndex="3" GridPane.rowIndex="2">
                                <Label style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Tarifa Base (T_tarBase)"/>
                                <TextField fx:id="txtDetTarBase" editable="false" style="-fx-background-color: #FEF3C7; -fx-background-radius: 8; -fx-padding: 8 10 8 10; -fx-font-weight: bold; -fx-text-fill: #D97706;"/>
                            </VBox>

                            <!-- Fila 3: Estado, Fecha Adquisición, Precio Adquisición, Fecha Baja -->
                            <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="3">
                                <Label style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Estado BD (V_est)"/>
                                <TextField fx:id="txtDetEst" editable="false" style="-fx-background-color: #F3F4F6; -fx-background-radius: 8; -fx-padding: 8 10 8 10;"/>
                            </VBox>

                            <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                <Label style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Fecha Adq. (V_fAdq)"/>
                                <DatePicker fx:id="dpDetFAdq" editable="false" focusTraversable="false" maxWidth="Infinity" mouseTransparent="true"
                                            promptText="dd-mm-aaaa"
                                            style="-fx-background-color: #F3F4F6; -fx-background-radius: 8;"/>
                            </VBox>

                            <VBox spacing="4.0" GridPane.columnIndex="2" GridPane.rowIndex="3">
                                <Label style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Precio Adq. (V_preAdq)"/>
                                <TextField fx:id="txtDetPreAdq" editable="false" style="-fx-background-color: #F3F4F6; -fx-background-radius: 8; -fx-padding: 8 10 8 10;"/>
                            </VBox>

                            <VBox spacing="4.0" GridPane.columnIndex="3" GridPane.rowIndex="3">
                                <Label style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Fecha Baja (V_fBaja)"/>
                                <HBox spacing="6.0">
                                    <DatePicker fx:id="dpDetFBaja" editable="false" focusTraversable="false" maxWidth="Infinity" mouseTransparent="true" HBox.hgrow="ALWAYS"
                                                promptText="Sin baja"
                                                style="-fx-background-color: #F3F4F6; -fx-background-radius: 8;"/>
                                    <Button fx:id="btnLimpiarFBajaDetalle" managed="false" onAction="#limpiarFechaBajaDetalle" prefHeight="34.0" visible="false"
                                            style="-fx-background-color: #F3F4F6; -fx-text-fill: #6B7280; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"
                                            text="✕"/>
                                </HBox>
                            </VBox>

                            <!-- Fila 4: Sucursal -->
                            <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="4">
                                <Label style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Sucursal (cod_Pertenece)"/>
                                <ComboBox fx:id="cmbDetSucursal" focusTraversable="false" maxWidth="Infinity" mouseTransparent="true" style="-fx-background-color: #F3F4F6; -fx-background-radius: 8;"/>
                            </VBox>
                        </GridPane>

                        <Separator fx:id="sepAccionesEdicionDetalle" managed="false" visible="false"/>

                        <HBox fx:id="boxAccionesEdicionDetalle" alignment="CENTER_RIGHT" managed="false" spacing="12.0" visible="false">
                            <Button onAction="#cancelarEdicionDetalle" prefHeight="40.0"
                                    style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 0 18 0 18; -fx-cursor: hand;"
                                    text="Cancelar"/>
                            <Button onAction="#guardarCambiosVehiculo" prefHeight="40.0"
                                    style="-fx-background-color: #F59E0B; -fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 0 22 0 22; -fx-cursor: hand;"
                                    text="Guardar Cambios"/>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Barra inferior: Acciones de Taller y Mantenimiento del Vehículo -->
                <HBox alignment="CENTER_LEFT" spacing="16.0"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 16; -fx-border-color: #E5E7EB; -fx-border-radius: 16; -fx-padding: 16 24 16 24;">
                    <VBox spacing="2.0">
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;"
                                   text="Historial y Registro de Mantenimiento"/>
                            <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #D97706; -fx-background-color: #FEF3C7; -fx-background-radius: 6; -fx-padding: 2 8 2 8;"
                                   text="Taller Oficial"/>
                        </HBox>
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"
                               text="Consulte los servicios mecánicos previos o registre un nuevo mantenimiento para esta unidad"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnVerMantenimientos" onAction="#abrirHistorialMantenimiento" prefHeight="40.0"
                            style="-fx-background-color: #F3F4F6; -fx-text-fill: #111827; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 0 18 0 18; -fx-cursor: hand; -fx-border-color: #D1D5DB; -fx-border-radius: 10;"
                            text="🛠 Ver Mantenimientos Previos"/>
                    <Button fx:id="btnNuevoMantenimiento" onAction="#abrirNuevoMantenimiento" prefHeight="40.0"
                            style="-fx-background-color: #111827; -fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 0 20 0 20; -fx-cursor: hand;"
                            text="+ Registrar Nuevo Mantenimiento"/>
                </HBox>
            </VBox>

            <!-- ========================================================================= -->
            <!-- VISTA 3: ALTA DE NUEVO VEHÍCULO (SIN FECHA DE BAJA)                       -->
            <!-- ========================================================================= -->
            <VBox fx:id="vistaAlta" managed="false" spacing="18.0" visible="false">
                <padding>
                    <Insets bottom="24.0" left="28.0" right="28.0" top="22.0"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Button onAction="#mostrarVistaGaleria" prefHeight="36.0"
                            style="-fx-background-color: #FFFFFF; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-text-fill: #374151; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 0 14 0 14; -fx-cursor: hand;"
                            text="← Volver a la Galería"/>
                    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;"
                           text="Alta de Nuevo Vehículo"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button onAction="#limpiarCampos"
                            style="-fx-background-color: transparent; -fx-text-fill: #6B7280; -fx-font-size: 13px; -fx-cursor: hand;"
                            text="Limpiar"/>
                </HBox>

                <VBox spacing="16.0" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 16; -fx-border-color: #E5E7EB; -fx-border-radius: 16; -fx-padding: 24;">

                    <GridPane hgap="16.0" vgap="14.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0"/>
                        </columnConstraints>

                        <!-- Fila 0: Patente, Marca, Modelo, Año Fabr. -->
                        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Patente (V_pat · Única)"/>
                            <TextField fx:id="txtPat" promptText="Ej. AB123CD" style="-fx-background-color: #F3F4F6; -fx-background-radius: 10; -fx-padding: 9 12 9 12;"/>
                        </VBox>

                        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Marca (V_marca)"/>
                            <ComboBox fx:id="comboMarca" maxWidth="Infinity" promptText="Seleccione marca" style="-fx-background-color: #F3F4F6; -fx-background-radius: 10;"/>
                        </VBox>

                        <VBox spacing="5.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Modelo (V_mod)"/>
                            <ComboBox fx:id="comboModelo" maxWidth="Infinity" promptText="Seleccione modelo" style="-fx-background-color: #F3F4F6; -fx-background-radius: 10;"/>
                        </VBox>

                        <VBox spacing="5.0" GridPane.columnIndex="3" GridPane.rowIndex="0">
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Año Fabr. (V_aFabr)"/>
                            <ComboBox fx:id="cmbAFabr" maxWidth="Infinity" promptText="Seleccione año" style="-fx-background-color: #F3F4F6; -fx-background-radius: 10;"/>
                        </VBox>

                        <!-- Fila 1: Fecha Adquisición, Kilometraje, Estado, Precio Adquisición -->
                        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Fecha Adq. (V_fAdq)"/>
                            <DatePicker fx:id="dpFAdq" editable="false" maxWidth="Infinity"
                                        promptText="dd-mm-aaaa"
                                        style="-fx-background-color: #F3F4F6; -fx-background-radius: 10;"/>
                        </VBox>

                        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Kilometraje (V_kmj)"/>
                            <TextField fx:id="txtKmj" promptText="Ej. 15000" style="-fx-background-color: #F3F4F6; -fx-background-radius: 10; -fx-padding: 9 12 9 12;"/>
                        </VBox>

                        <VBox spacing="5.0" GridPane.columnIndex="2" GridPane.rowIndex="1">
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Estado (V_est)"/>
                            <TextField fx:id="txtEst" promptText="Disponible" style="-fx-background-color: #F3F4F6; -fx-background-radius: 10; -fx-padding: 9 12 9 12;"/>
                        </VBox>

                        <VBox spacing="5.0" GridPane.columnIndex="3" GridPane.rowIndex="1">
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Precio Adq. (V_preAdq)"/>
                            <TextField fx:id="txtPreAdq" promptText="Ej. 25000.0" style="-fx-background-color: #F3F4F6; -fx-background-radius: 10; -fx-padding: 9 12 9 12;"/>
                        </VBox>

                        <!-- Fila 2: Combustible (Nafta/Diesel), Transmisión (Manual/Automática), Categoría, Cap. Carga -->
                        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Combustible (V_tiComb)"/>
                            <ComboBox fx:id="cmbTiComb" maxWidth="Infinity" promptText="Seleccione combustible" style="-fx-background-color: #F3F4F6; -fx-background-radius: 10;"/>
                        </VBox>

                        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Transmisión (V_tran)"/>
                            <ComboBox fx:id="cmbTransmision" maxWidth="Infinity" promptText="Seleccione transmisión" style="-fx-background-color: #F3F4F6; -fx-background-radius: 10;"/>
                        </VBox>

                        <VBox spacing="5.0" GridPane.columnIndex="2" GridPane.rowIndex="2">
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Categoría (T_cat)"/>
                            <ComboBox fx:id="cmbCat" maxWidth="Infinity" style="-fx-background-color: #F3F4F6; -fx-background-radius: 10;"/>
                        </VBox>

                        <VBox spacing="5.0" GridPane.columnIndex="3" GridPane.rowIndex="2">
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Cap. Carga (T_carga)"/>
                            <TextField fx:id="txtCarga" promptText="Ej. 450.0" style="-fx-background-color: #F3F4F6; -fx-background-radius: 10; -fx-padding: 9 12 9 12;"/>
                        </VBox>

                        <!-- Fila 3: Pasajeros, Tarifa Base, Sucursal -->
                        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="3">
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Pasajeros (T_pax)"/>
                            <TextField fx:id="txtPax" promptText="Ej. 5" style="-fx-background-color: #F3F4F6; -fx-background-radius: 10; -fx-padding: 9 12 9 12;"/>
                        </VBox>

                        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Tarifa Base (T_tarBase)"/>
                            <TextField fx:id="txtTarBase" promptText="Ej. 85.0" style="-fx-background-color: #F3F4F6; -fx-background-radius: 10; -fx-padding: 9 12 9 12;"/>
                        </VBox>

                        <!-- Selección de Sucursal mediante lista desplegable 'cod - nombre' -->
                        <VBox spacing="5.0" GridPane.columnIndex="2" GridPane.columnSpan="2" GridPane.rowIndex="3">
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Sucursal (cod_Pertenece)"/>
                            <ComboBox fx:id="cmbSucursal" maxWidth="Infinity"
                                      promptText="Seleccione (cod - nombre)"
                                      style="-fx-background-color: #F3F4F6; -fx-background-radius: 10;"/>
                        </VBox>
                    </GridPane>

                    <Region VBox.vgrow="ALWAYS"/>

                    <Button maxWidth="Infinity" onAction="#guardarVehiculo" prefHeight="44.0"
                            style="-fx-background-color: #262626; -fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;"
                            text="Guardar Vehículo"/>
                </VBox>
            </VBox>

            <!-- ========================================================================= -->
            <!-- VISTA 4: HISTORIAL DE MANTENIMIENTOS PREVIOS DEL VEHÍCULO                 -->
            <!-- ========================================================================= -->
            <VBox fx:id="vistaHistorialMantenimiento" managed="false" spacing="18.0" visible="false">
                <padding>
                    <Insets bottom="24.0" left="28.0" right="28.0" top="22.0"/>
                </padding>

                <!-- Barra superior de navegación y resumen -->
                <HBox alignment="CENTER_LEFT" spacing="14.0"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 16; -fx-border-color: #E5E7EB; -fx-border-radius: 16; -fx-padding: 16 24 16 24;">
                    <Button onAction="#volverADetalleDesdeMantenimiento" prefHeight="36.0"
                            style="-fx-background-color: #F3F4F6; -fx-text-fill: #111827; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 0 14 0 14; -fx-cursor: hand;"
                            text="← Volver a Ficha del Vehículo"/>

                    <VBox spacing="2.0">
                        <Label fx:id="lblHistorialTitulo"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;"
                               text="Mantenimientos Previos"/>
                        <Label fx:id="lblHistorialSubtitulo"
                               style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"
                               text="Unidad: - · Patente: -"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- KPI: Cantidad de Servicios -->
                    <HBox alignment="CENTER" spacing="8.0"
                          style="-fx-background-color: #F3F4F6; -fx-background-radius: 10; -fx-padding: 6 14 6 14;">
                        <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6B7280;" text="SERVICIOS:"/>
                        <Label fx:id="lblHistorialTotalServicios" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="0"/>
                    </HBox>

                    <!-- KPI: Costo Total Acumulado -->
                    <HBox alignment="CENTER" spacing="8.0"
                          style="-fx-background-color: #FEF3C7; -fx-background-radius: 10; -fx-border-color: #FDE68A; -fx-border-radius: 10; -fx-padding: 6 14 6 14;">
                        <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #92400E;" text="COSTO TOTAL:"/>
                        <Label fx:id="lblHistorialCostoTotal" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #D97706;" text="\$0.00"/>
                    </HBox>

                    <!-- Botón directo para registrar nuevo mantenimiento -->
                    <Button onAction="#mostrarVistaNuevoMantenimientoDesdeHistorial" prefHeight="36.0"
                            style="-fx-background-color: #111827; -fx-text-fill: #FFFFFF; -fx-font-size: 12.5px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 0 16 0 16; -fx-cursor: hand;"
                            text="+ Registrar Nuevo Mantenimiento"/>
                </HBox>

                <!-- Contenido: Tarjeta con Tabla de Mantenimientos -->
                <VBox spacing="14.0" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 16; -fx-border-color: #E5E7EB; -fx-border-radius: 16; -fx-padding: 20 24 20 24;">

                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #111827;"
                               text="Historial de Servicios en Taller (Entidad Mantenimientos)"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblHistorialEstadoTabla" style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"
                               text="Mostrando todos los registros"/>
                    </HBox>

                    <TableView fx:id="tablaMantenimientos" VBox.vgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10;">
                        <columns>
                            <TableColumn fx:id="colMantId" prefWidth="60.0" text="# ID"/>
                            <TableColumn fx:id="colMantFecha" prefWidth="105.0" text="Fecha"/>
                            <TableColumn fx:id="colMantTipo" prefWidth="120.0" text="Tipo de Servicio"/>
                            <TableColumn fx:id="colMantKmj" prefWidth="100.0" text="Kilometraje"/>
                            <TableColumn fx:id="colMantCosto" prefWidth="110.0" text="Costo ($)"/>
                            <TableColumn fx:id="colMantEmpleado" prefWidth="180.0" text="Mecánico / Empleado"/>
                            <TableColumn fx:id="colMantObs" prefWidth="240.0" text="Observaciones"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </VBox>

            <!-- ========================================================================= -->
            <!-- VISTA 5: REGISTRO DE NUEVO MANTENIMIENTO (TRANSACCIÓN 4.4)                -->
            <!-- ========================================================================= -->
            <VBox fx:id="vistaNuevoMantenimiento" managed="false" spacing="18.0" visible="false">
                <padding>
                    <Insets bottom="24.0" left="28.0" right="28.0" top="22.0"/>
                </padding>

                <!-- Barra superior -->
                <HBox alignment="CENTER_LEFT" spacing="14.0"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 16; -fx-border-color: #E5E7EB; -fx-border-radius: 16; -fx-padding: 16 24 16 24;">
                    <Button onAction="#volverADetalleDesdeNuevoMantenimiento" prefHeight="36.0"
                            style="-fx-background-color: #F3F4F6; -fx-text-fill: #111827; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 0 14 0 14; -fx-cursor: hand;"
                            text="← Volver"/>

                    <VBox spacing="2.0">
                        <Label fx:id="lblNuevoMantTitulo"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;"
                               text="Registrar Nuevo Mantenimiento"/>
                        <Label fx:id="lblNuevoMantSubtitulo"
                               style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"
                               text="Carga de servicio en taller oficial (Transacción 4.4)"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button onAction="#limpiarFormularioNuevoMantenimiento"
                            style="-fx-background-color: transparent; -fx-text-fill: #6B7280; -fx-font-size: 13px; -fx-cursor: hand;"
                            text="Limpiar Formulario"/>
                </HBox>

                <!-- Formulario principal con estilo de tarjeta -->
                <VBox spacing="18.0" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 16; -fx-border-color: #E5E7EB; -fx-border-radius: 16; -fx-padding: 24;">

                    <!-- Resumen del Vehículo seleccionado -->
                    <HBox alignment="CENTER_LEFT" spacing="16.0"
                          style="-fx-background-color: #F9FAFB; -fx-background-radius: 12; -fx-border-color: #E5E7EB; -fx-border-radius: 12; -fx-padding: 14 18 14 18;">
                        <VBox spacing="2.0">
                            <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6B7280;" text="VEHÍCULO"/>
                            <Label fx:id="lblNuevoMantVehiculoInfo" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="-"/>
                        </VBox>
                        <Separator orientation="VERTICAL"/>
                        <VBox spacing="2.0">
                            <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6B7280;" text="PATENTE"/>
                            <Label fx:id="lblNuevoMantPatente" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="-"/>
                        </VBox>
                        <Separator orientation="VERTICAL"/>
                        <VBox spacing="2.0">
                            <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6B7280;" text="KILOMETRAJE REGISTRADO"/>
                            <Label fx:id="lblNuevoMantKmjActual" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #D97706;" text="- km"/>
                        </VBox>
                        <Separator orientation="VERTICAL"/>
                        <VBox spacing="2.0">
                            <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6B7280;" text="SUCURSAL PERTENECIENTE"/>
                            <Label fx:id="lblNuevoMantSucursal" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="-"/>
                        </VBox>
                    </HBox>

                    <!-- Campos del Mantenimiento -->
                    <GridPane hgap="18.0" vgap="16.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="33.34"/>
                        </columnConstraints>

                        <!-- Fila 0: Fecha, Tipo, Kilometraje -->
                        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Fecha de Mantenimiento (M_fec) *"/>
                            <DatePicker fx:id="dpNuevoMantFecha" editable="false" maxWidth="Infinity" promptText="dd-mm-aaaa"
                                        style="-fx-background-color: #F3F4F6; -fx-background-radius: 10;"/>
                        </VBox>

                        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Tipo de Mantenimiento (M_tipo) *"/>
                            <ComboBox fx:id="cmbNuevoMantTipo" maxWidth="Infinity" promptText="Seleccione tipo"
                                      style="-fx-background-color: #F3F4F6; -fx-background-radius: 10;"/>
                        </VBox>

                        <VBox spacing="5.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Kilometraje al Servicio (M_kmj) *"/>
                            <TextField fx:id="txtNuevoMantKmj" promptText="Ej. 45000"
                                       style="-fx-background-color: #F3F4F6; -fx-background-radius: 10; -fx-padding: 9 12 9 12;"/>
                        </VBox>

                        <!-- Fila 1: Costo, Empleado que Realiza -->
                        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Costo del Servicio en $ (M_costo) *"/>
                            <TextField fx:id="txtNuevoMantCosto" promptText="Ej. 18500.00"
                                       style="-fx-background-color: #FEF3C7; -fx-background-radius: 10; -fx-padding: 9 12 9 12; -fx-font-weight: bold; -fx-text-fill: #D97706;"/>
                        </VBox>

                        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="1">
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Mecánico / Empleado Responsable (id_Realiza) *"/>
                            <ComboBox fx:id="cmbNuevoMantEmpleado" maxWidth="Infinity" promptText="Seleccione empleado"
                                      style="-fx-background-color: #F3F4F6; -fx-background-radius: 10;"/>
                        </VBox>

                        <!-- Fila 2: Observaciones (opcional, máx 100 caracteres) -->
                        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.columnSpan="3" GridPane.rowIndex="2">
                            <HBox alignment="CENTER_LEFT">
                                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Observaciones / Detalle del Trabajo (M_obs · Opcional)"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="lblNuevoMantContadorObs" style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;" text="0 / 100 caracteres"/>
                            </HBox>
                            <TextField fx:id="txtNuevoMantObs" promptText="Describa repuestos cambiados o detalles técnicos (máx. 100 caracteres)..."
                                       style="-fx-background-color: #F3F4F6; -fx-background-radius: 10; -fx-padding: 9 12 9 12;"/>
                        </VBox>
                    </GridPane>

                    <Region VBox.vgrow="ALWAYS"/>

                    <!-- Botones de Acción -->
                    <HBox alignment="CENTER_RIGHT" spacing="12.0">
                        <Button onAction="#volverADetalleDesdeNuevoMantenimiento" prefHeight="42.0"
                                style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 0 20 0 20; -fx-cursor: hand;"
                                text="Cancelar"/>
                        <Button onAction="#guardarNuevoMantenimiento" prefHeight="42.0"
                                style="-fx-background-color: #262626; -fx-text-fill: #FFFFFF; -fx-font-size: 13.5px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 0 24 0 24; -fx-cursor: hand;"
                                text="Guardar Mantenimiento"/>
                    </HBox>
                </VBox>
            </VBox>

        </StackPane>
    </center>
</BorderPane>
