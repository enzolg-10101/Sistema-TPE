<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="960.0"
            style="-fx-background-color: #F3F4F6; -fx-font-family: 'Segoe UI', 'Inter', sans-serif;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controlador.ContratoController">

    <!-- ========================================================================= -->
    <!-- REGIÓN TOP: BUSCADOR EN TIEMPO REAL ('campoBusqueda') Y '+ NUEVO CONTRATO' -->
    <!-- ========================================================================= -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14.0"
              style="-fx-background-color: #FFFFFF; -fx-background-radius: 16; -fx-border-color: #E5E7EB; -fx-border-radius: 16; -fx-padding: 18 24 18 24;">
            <BorderPane.margin>
                <Insets bottom="8.0" left="28.0" right="28.0" top="22.0"/>
            </BorderPane.margin>

            <VBox spacing="2.0">
                <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;"
                       text="Gestión de Contratos"/>
                <Label fx:id="lblContadorContratos"
                       style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"
                       text="Listado completo de contratos registrados en el sistema"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <TextField fx:id="campoBusqueda" prefWidth="290.0"
                       promptText="Buscar por N°, Cliente, DNI o Patente..."
                       style="-fx-background-color: #F3F4F6; -fx-background-radius: 10; -fx-border-color: transparent; -fx-padding: 10 14 10 14; -fx-font-size: 13px;"/>

            <Button fx:id="btnNuevoContrato" onAction="#abrirNuevoContrato" prefHeight="40.0"
                    style="-fx-background-color: #262626; -fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 0 20 0 20; -fx-cursor: hand;"
                    text="+ Nuevo Contrato"/>
        </HBox>
    </top>

    <!-- ========================================================================= -->
    <!-- REGIÓN CENTER: TABLEVIEW CON ATRIBUTOS PRINCIPALES DEL CONTRATO           -->
    <!-- ========================================================================= -->
    <center>
        <VBox spacing="12.0"
              style="-fx-background-color: #FFFFFF; -fx-background-radius: 16; -fx-border-color: #E5E7EB; -fx-border-radius: 16; -fx-padding: 20;">
            <BorderPane.margin>
                <Insets bottom="24.0" left="28.0" right="28.0" top="10.0"/>
            </BorderPane.margin>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;"
                       text="Contratos Registrados"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#cargarContratos" prefHeight="28.0"
                        style="-fx-background-color: #F3F4F6; -fx-text-fill: #4B5563; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-padding: 4 12 4 12; -fx-cursor: hand;"
                        text="↻ Recargar"/>
                <Label style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"
                       text="Haga clic sobre un contrato para ver su detalle completo"/>
            </HBox>

            <TableView fx:id="tablaContratos" VBox.vgrow="ALWAYS"
                       style="-fx-background-radius: 10; -fx-border-color: #E5E7EB; -fx-border-radius: 10;">
                <placeholder>
                    <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 13px;"
                           text="No se encontraron contratos que coincidan con la búsqueda."/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="colNro" prefWidth="85.0" text="N° Contrato"/>
                    <TableColumn fx:id="colCliente" prefWidth="160.0" text="Cliente"/>
                    <TableColumn fx:id="colVehiculo" prefWidth="150.0" text="Vehículo"/>
                    <TableColumn fx:id="colPatente" prefWidth="95.0" text="Patente"/>
                    <TableColumn fx:id="colFechaEntrega" prefWidth="105.0" text="Entrega"/>
                    <TableColumn fx:id="colFechaDevolucion" prefWidth="105.0" text="Devolución"/>
                    <TableColumn fx:id="colImporte" prefWidth="105.0" text="Importe Alq."/>
                    <TableColumn fx:id="colEstado" prefWidth="95.0" text="Estado"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <!-- ========================================================================= -->
    <!-- REGIÓN RIGHT: DETALLE COMPLETO DEL CONTRATO SELECCIONADO                   -->
    <!-- ========================================================================= -->
    <right>
        <VBox fx:id="panelDetalleContrato" managed="false" prefWidth="360.0" spacing="12.0" visible="false"
              style="-fx-background-color: #FFFFFF; -fx-background-radius: 16; -fx-border-color: #E5E7EB; -fx-border-radius: 16; -fx-padding: 20;">
            <BorderPane.margin>
                <Insets bottom="24.0" left="0.0" right="28.0" top="10.0"/>
            </BorderPane.margin>

            <!-- Encabezado del panel -->
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <VBox spacing="2.0">
                    <Label fx:id="lblBadgeEstadoDetalle"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #065F46; -fx-background-color: #D1FAE5; -fx-background-radius: 8; -fx-padding: 3 10 3 10;"
                           text="ACTIVO"/>
                    <Label fx:id="lblTituloPanel"
                           style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #111827;"
                           text="Detalle del Contrato"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button onAction="#cerrarPanelDetalle" prefHeight="32.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #6B7280; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 0 8 0 8; -fx-cursor: hand;"
                        text="✕"/>
            </HBox>

            <Separator/>

            <!-- Información detallada del contrato (solo lectura) -->
            <GridPane hgap="12.0" vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                </columnConstraints>

                <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                           text="N° de Contrato"/>
                    <TextField fx:id="txtDetalleNro" editable="false"
                               style="-fx-background-color: #F3F4F6; -fx-background-radius: 8; -fx-padding: 8 10 8 10; -fx-font-weight: bold;"/>
                </VBox>

                <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                           text="Condición Uso"/>
                    <TextField fx:id="txtDetalleCondUso" editable="false"
                               style="-fx-background-color: #F3F4F6; -fx-background-radius: 8; -fx-padding: 8 10 8 10;"/>
                </VBox>

                <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                           text="Cliente Firmante"/>
                    <TextField fx:id="txtDetalleCliente" editable="false"
                               style="-fx-background-color: #F3F4F6; -fx-background-radius: 8; -fx-padding: 8 10 8 10; -fx-font-weight: bold;"/>
                </VBox>

                <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                           text="DNI Cliente"/>
                    <TextField fx:id="txtDetalleDni" editable="false"
                               style="-fx-background-color: #F3F4F6; -fx-background-radius: 8; -fx-padding: 8 10 8 10;"/>
                </VBox>

                <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                           text="Patente Vehículo"/>
                    <TextField fx:id="txtDetallePatente" editable="false"
                               style="-fx-background-color: #F3F4F6; -fx-background-radius: 8; -fx-padding: 8 10 8 10;"/>
                </VBox>

                <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="3">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                           text="Vehículo Asignado"/>
                    <TextField fx:id="txtDetalleVehiculo" editable="false"
                               style="-fx-background-color: #F3F4F6; -fx-background-radius: 8; -fx-padding: 8 10 8 10;"/>
                </VBox>

                <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="4">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                           text="Fecha Entrega"/>
                    <TextField fx:id="txtDetalleFeEnt" editable="false"
                               style="-fx-background-color: #F3F4F6; -fx-background-radius: 8; -fx-padding: 8 10 8 10;"/>
                </VBox>

                <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="4">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                           text="Fecha Devolución"/>
                    <TextField fx:id="txtDetalleFeDev" editable="false"
                               style="-fx-background-color: #F3F4F6; -fx-background-radius: 8; -fx-padding: 8 10 8 10;"/>
                </VBox>

                <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="5">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                           text="Importe Alquiler"/>
                    <TextField fx:id="txtDetalleImpAlq" editable="false"
                               style="-fx-background-color: #FEF3C7; -fx-background-radius: 8; -fx-padding: 8 10 8 10; -fx-font-weight: bold; -fx-text-fill: #D97706;"/>
                </VBox>

                <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="5">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                           text="Fianza"/>
                    <TextField fx:id="txtDetalleFianza" editable="false"
                               style="-fx-background-color: #F3F4F6; -fx-background-radius: 8; -fx-padding: 8 10 8 10;"/>
                </VBox>
            </GridPane>

            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </right>

</BorderPane>

