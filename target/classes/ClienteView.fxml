<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="940.0"
            style="-fx-background-color: #F3F4F6; -fx-font-family: 'Segoe UI', 'Inter', sans-serif;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controlador.ClienteController">

    <!-- ========================================================================= -->
    <!-- REGIÓN TOP: BUSCADOR EN TIEMPO REAL ('campoBusqueda') Y 'NUEVO CLIENTE'   -->
    <!-- ========================================================================= -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14.0"
              style="-fx-background-color: #FFFFFF; -fx-background-radius: 16; -fx-border-color: #E5E7EB; -fx-border-radius: 16; -fx-padding: 18 24 18 24;">
            <BorderPane.margin>
                <Insets bottom="8.0" left="28.0" right="28.0" top="22.0"/>
            </BorderPane.margin>

            <VBox spacing="2.0">
                <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;"
                       text="Gestión de Clientes"/>
                <Label fx:id="lblContadorClientes"
                       style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"
                       text="Seleccione un cliente de la tabla para ver o editar su información completa"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <TextField fx:id="campoBusqueda" prefWidth="290.0"
                       promptText="Buscar por DNI o Nombre"
                       style="-fx-background-color: #F3F4F6; -fx-background-radius: 10; -fx-border-color: transparent; -fx-padding: 10 14 10 14; -fx-font-size: 13px;"/>

            <Button fx:id="btnNuevoCliente" onAction="#abrirVentanaNuevoCliente" prefHeight="40.0"
                    style="-fx-background-color: #262626; -fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 0 20 0 20; -fx-cursor: hand;"
                    text="Nuevo Cliente"/>
        </HBox>
    </top>

    <!-- ========================================================================= -->
    <!-- REGIÓN CENTER: TABLEVIEW CON COLUMNAS DNI, NOMBRE, TELÉFONO Y ESTADO      -->
    <!-- ========================================================================= -->
    <center>
        <VBox spacing="12.0"
              style="-fx-background-color: #FFFFFF; -fx-background-radius: 16; -fx-border-color: #E5E7EB; -fx-border-radius: 16; -fx-padding: 20;">
            <BorderPane.margin>
                <Insets bottom="24.0" left="28.0" right="28.0" top="10.0"/>
            </BorderPane.margin>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;"
                       text="Padrón de Clientes"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"
                       text="Haga clic sobre un cliente para ver su ficha completa o editarla"/>
            </HBox>

            <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS"
                       style="-fx-background-radius: 10; -fx-border-color: #E5E7EB; -fx-border-radius: 10;">
                <placeholder>
                    <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 13px;"
                           text="No se encontraron clientes que coincidan con la búsqueda."/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="colDni" prefWidth="110.0" text="DNI"/>
                    <TableColumn fx:id="colNombre" prefWidth="150.0" text="Nombre"/>
                    <TableColumn fx:id="colTelefono" prefWidth="130.0" text="Teléfono"/>
                    <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <!-- ========================================================================= -->
    <!-- REGIÓN RIGHT: OCULTA POR DEFECTO, SE ABRE SOLO AL HACER CLIC EN UN CLIENTE -->
    <!-- ========================================================================= -->
    <right>
        <VBox fx:id="panelDetalleCliente" managed="false" prefWidth="360.0" spacing="12.0" visible="false"
              style="-fx-background-color: #FFFFFF; -fx-background-radius: 16; -fx-border-color: #E5E7EB; -fx-border-radius: 16; -fx-padding: 20;">
            <BorderPane.margin>
                <Insets bottom="24.0" left="0.0" right="28.0" top="10.0"/>
            </BorderPane.margin>

            <!-- Encabezado del panel con etiqueta de modo, botón de edición in-situ y botón cerrar -->
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <VBox spacing="2.0">
                    <Label fx:id="lblBadgeModo"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #D97706; -fx-background-color: #FEF3C7; -fx-background-radius: 8; -fx-padding: 3 10 3 10;"
                           text="INFORMACIÓN COMPLETA"/>
                    <Label fx:id="lblTituloPanel"
                           style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #111827;"
                           text="Ficha del Cliente"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnEditarCliente" onAction="#habilitarEdicionCliente" prefHeight="32.0"
                        style="-fx-background-color: #F3F4F6; -fx-text-fill: #111827; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-color: #D1D5DB; -fx-border-radius: 8; -fx-padding: 0 12 0 12; -fx-cursor: hand;"
                        text="Editar"/>

                <Button onAction="#cerrarPanelDetalle" prefHeight="32.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #6B7280; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 0 8 0 8; -fx-cursor: hand;"
                        text="✕"/>
            </HBox>

            <Separator/>

            <!-- Formulario con toda la información del Cliente (sin ID manual, C_id es AUTO_INCREMENT) -->
            <GridPane hgap="12.0" vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                </columnConstraints>

                <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                           text="DNI (C_dni · Único)"/>
                    <TextField fx:id="txtDni" editable="false" promptText="Ej. 38450123"
                               style="-fx-background-color: #F3F4F6; -fx-background-radius: 8; -fx-padding: 8 10 8 10;"/>
                </VBox>

                <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                           text="Estado"/>
                    <ComboBox fx:id="cmbEstado" disable="true" maxWidth="Infinity"
                              style="-fx-background-color: #F3F4F6; -fx-background-radius: 8;"/>
                </VBox>

                <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                           text="Nombre (C_nom)"/>
                    <TextField fx:id="txtNom" editable="false" promptText="Nombre"
                               style="-fx-background-color: #F3F4F6; -fx-background-radius: 8; -fx-padding: 8 10 8 10;"/>
                </VBox>

                <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                           text="Apellido (C_apl)"/>
                    <TextField fx:id="txtApl" editable="false" promptText="Apellido"
                               style="-fx-background-color: #F3F4F6; -fx-background-radius: 8; -fx-padding: 8 10 8 10;"/>
                </VBox>

                <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                           text="Teléfono (C_tel)"/>
                    <TextField fx:id="txtTel" editable="false" promptText="Ej. 1145678901"
                               style="-fx-background-color: #F3F4F6; -fx-background-radius: 8; -fx-padding: 8 10 8 10;"/>
                </VBox>

                <!-- Fecha de Alta seleccionable por calendario (no editable a mano) -->
                <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                           text="Fecha Alta (C_fAlta)"/>
                    <DatePicker fx:id="dpFechaAlta" disable="true" editable="false" maxWidth="Infinity"
                                promptText="Calendario"
                                style="-fx-background-color: #F3F4F6; -fx-background-radius: 8;"/>
                </VBox>

                <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="3">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                           text="Correo Electrónico (C_correo)"/>
                    <TextField fx:id="txtCorreo" editable="false" promptText="cliente@correo.com"
                               style="-fx-background-color: #F3F4F6; -fx-background-radius: 8; -fx-padding: 8 10 8 10;"/>
                </VBox>

                <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="4">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                           text="Dirección (C_dir)"/>
                    <TextField fx:id="txtDir" editable="false" promptText="Calle y número"
                               style="-fx-background-color: #F3F4F6; -fx-background-radius: 8; -fx-padding: 8 10 8 10;"/>
                </VBox>
            </GridPane>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Botones de acción en el mismo panel (visibles al editar o al crear Nuevo Cliente) -->
            <HBox fx:id="contenedorAccionesEdicion" managed="false" spacing="10.0" visible="false">
                <Button fx:id="btnCancelarEdicion" maxWidth="Infinity" onAction="#cancelarEdicion" prefHeight="40.0"
                        HBox.hgrow="ALWAYS"
                        style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="Cancelar"/>
                <Button fx:id="btnGuardarCambios" maxWidth="Infinity" onAction="#guardarCliente" prefHeight="40.0"
                        HBox.hgrow="ALWAYS"
                        style="-fx-background-color: #262626; -fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="Guardar Cambios"/>
            </HBox>
        </VBox>
    </right>

</BorderPane>
