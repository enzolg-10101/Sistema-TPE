<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="900.0"
            style="-fx-background-color: #F3F4F6; -fx-font-family: 'Segoe UI', 'Inter', sans-serif;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controlador.EmpleadoController">

    <center>
        <StackPane>

            <!-- ========================================================================= -->
            <!-- VISTA 1: BUSCADOR DINÁMICO DE EMPLEADOS (Visible al pulsar 'Empleados')    -->
            <!-- ========================================================================= -->
            <VBox fx:id="vistaBuscador" spacing="20.0">
                <padding>
                    <Insets bottom="24.0" left="28.0" right="28.0" top="22.0"/>
                </padding>

                <!-- Encabezado superior con botón aparte para ir al Alta de Empleados -->
                <HBox alignment="CENTER_LEFT" spacing="14.0">
                    <VBox spacing="2.0">
                        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;"
                               text="Gestión de Empleados"/>
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"
                               text="Consulte y filtre el padrón de empleados en tiempo real"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button onAction="#mostrarPantallaAlta" prefHeight="40.0"
                            style="-fx-background-color: #262626; -fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 0 20 0 20; -fx-cursor: hand;"
                            text="+ Alta de Empleado"/>
                </HBox>

                <!-- Tarjeta del Buscador Dinámico -->
                <VBox spacing="12.0"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 16; -fx-border-color: #E5E7EB; -fx-border-radius: 16; -fx-padding: 20 24 20 24;">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;"
                               text="Buscador de Empleados"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblCantidadResultados"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #D97706; -fx-background-color: #FEF3C7; -fx-background-radius: 12; -fx-padding: 4 12 4 12;"
                               text="0 empleados encontrados"/>
                        <Button onAction="#limpiarBusqueda"
                                style="-fx-background-color: transparent; -fx-text-fill: #6B7280; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 4 8 4 8;"
                                text="Limpiar"/>
                    </HBox>

                    <TextField fx:id="txtBuscar"
                               promptText="Escriba DNI, nombre, apellido, correo o código de sucursal para buscar dinámicamente..."
                               style="-fx-background-color: #F3F4F6; -fx-background-radius: 10; -fx-border-color: transparent; -fx-padding: 12 14 12 14; -fx-font-size: 13px;"/>
                </VBox>

                <!-- Tarjeta de Resultados Dinámicos -->
                <VBox spacing="12.0" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 16; -fx-border-color: #E5E7EB; -fx-border-radius: 16; -fx-padding: 20 24 20 24;">
                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;"
                           text="Resultados"/>

                    <TableView fx:id="tablaEmpleados" VBox.vgrow="ALWAYS"
                               style="-fx-background-radius: 10; -fx-border-color: #E5E7EB; -fx-border-radius: 10;">
                        <placeholder>
                            <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 13px;"
                                   text="No se encontraron empleados que coincidan con la búsqueda."/>
                        </placeholder>
                        <columns>
                            <TableColumn fx:id="colId" prefWidth="70.0" text="ID (E_id)"/>
                            <TableColumn fx:id="colDni" prefWidth="95.0" text="DNI"/>
                            <TableColumn fx:id="colNom" prefWidth="115.0" text="Nombre"/>
                            <TableColumn fx:id="colApl" prefWidth="115.0" text="Apellido"/>
                            <TableColumn fx:id="colDir" prefWidth="140.0" text="Dirección"/>
                            <TableColumn fx:id="colTel" prefWidth="105.0" text="Teléfono"/>
                            <TableColumn fx:id="colCorreo" prefWidth="150.0" text="Correo"/>
                            <TableColumn fx:id="colFIng" prefWidth="100.0" text="F. Ingreso"/>
                            <TableColumn fx:id="colCodTrabaja" prefWidth="85.0" text="Sucursal"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </VBox>

            <!-- ========================================================================= -->
            <!-- VISTA 2: ALTA DE EMPLEADOS (Sin campo ID, usa DNI único + AUTO_INCREMENT)  -->
            <!-- ========================================================================= -->
            <VBox fx:id="vistaAlta" managed="false" spacing="20.0" visible="false">
                <padding>
                    <Insets bottom="24.0" left="28.0" right="28.0" top="22.0"/>
                </padding>

                <!-- Encabezado superior con botón para regresar al buscador -->
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Button onAction="#mostrarPantallaBuscador" prefHeight="36.0"
                            style="-fx-background-color: #FFFFFF; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10; -fx-text-fill: #374151; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 0 14 0 14; -fx-cursor: hand;"
                            text="← Volver al Buscador"/>
                    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;"
                           text="Sistema de Alquiler de Vehículos"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox alignment="CENTER"
                          style="-fx-background-color: #F59E0B; -fx-background-radius: 20; -fx-padding: 6 16 6 16;">
                        <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 12px; -fx-font-weight: bold;"
                               text="Alta de Empleados"/>
                    </HBox>
                </HBox>

                <!-- Tarjeta Superior: Título a la izquierda + Grilla de DNI, Fecha y Sucursal a la derecha -->
                <HBox alignment="CENTER_LEFT" spacing="32.0"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 16; -fx-border-color: #E5E7EB; -fx-border-radius: 16; -fx-padding: 24 28 24 28;">

                    <VBox alignment="CENTER_LEFT" prefWidth="280.0" spacing="8.0">
                        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111827;"
                               text="Alta de Empleados" wrapText="true"/>
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"
                               text="Registre el DNI único, los datos de contacto y la sucursal asignada al empleado."
                               wrapText="true"/>
                        <Separator style="-fx-padding: 8 0 4 0;"/>
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #9CA3AF;"
                               text="El ID (E_id) se genera automáticamente en la base de datos."/>
                    </VBox>

                    <GridPane hgap="18.0" vgap="14.0" HBox.hgrow="ALWAYS">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                        </columnConstraints>

                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="0">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #111827;"
                                   text="DNI (E_dni · Único)"/>
                            <TextField fx:id="txtDni" promptText="Ej. 40123456"
                                       style="-fx-background-color: #F3F4F6; -fx-background-radius: 10; -fx-border-color: transparent; -fx-padding: 10 12 10 12; -fx-font-size: 13px;"/>
                        </VBox>

                        <!-- Fecha de Ingreso por Calendario (DatePicker no editable a mano) -->
                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #111827;"
                                   text="Fecha de Ingreso (E_fIng)"/>
                            <DatePicker fx:id="dpFIng" editable="false" maxWidth="Infinity"
                                        promptText="Seleccione en el calendario"
                                        style="-fx-background-color: #F3F4F6; -fx-background-radius: 10; -fx-font-size: 13px;"/>
                        </VBox>

                        <!-- Selección de Sucursal mediante lista desplegable 'cod - nombre' -->
                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #111827;"
                                   text="Sucursal donde trabaja (cod_Trabaja)"/>
                            <ComboBox fx:id="cmbSucursal" maxWidth="Infinity"
                                      promptText="Seleccione sucursal (cod - nombre)"
                                      style="-fx-background-color: #F3F4F6; -fx-background-radius: 10; -fx-font-size: 13px;"/>
                        </VBox>
                    </GridPane>
                </HBox>

                <!-- Sección Inferior Dividida en 2 Tarjetas -->
                <HBox spacing="20.0" VBox.vgrow="ALWAYS">

                    <!-- Tarjeta Izquierda: Datos Personales y botón Limpiar -->
                    <VBox prefWidth="340.0" spacing="16.0"
                          style="-fx-background-color: #FFFFFF; -fx-background-radius: 16; -fx-border-color: #E5E7EB; -fx-border-radius: 16; -fx-padding: 24;">

                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;"
                                   text="Datos Personales"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button onAction="#limpiarCampos"
                                    style="-fx-background-color: transparent; -fx-text-fill: #6B7280; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 4 8 4 8;"
                                    text="Limpiar"/>
                        </HBox>

                        <VBox spacing="6.0">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                                   text="Nombre (E_nom)"/>
                            <TextField fx:id="txtNom" promptText="Ingrese el nombre"
                                       style="-fx-background-color: #F3F4F6; -fx-background-radius: 10; -fx-border-color: transparent; -fx-padding: 10 12 10 12; -fx-font-size: 13px;"/>
                        </VBox>

                        <VBox spacing="6.0">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                                   text="Apellido (E_apl)"/>
                            <TextField fx:id="txtApl" promptText="Ingrese el apellido"
                                       style="-fx-background-color: #F3F4F6; -fx-background-radius: 10; -fx-border-color: transparent; -fx-padding: 10 12 10 12; -fx-font-size: 13px;"/>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS"/>

                        <VBox spacing="4.0"
                              style="-fx-background-color: #F9FAFB; -fx-background-radius: 10; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-padding: 12;">
                            <Label style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"
                                   text="Relación Trabaja (N:1)"/>
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #111827;"
                                   text="FK(cod_Trabaja) → Sucursales(S_cod)"/>
                        </VBox>
                    </VBox>

                    <!-- Tarjeta Derecha: Contacto, Domicilio y Botón Guardar -->
                    <VBox spacing="18.0" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #FFFFFF; -fx-background-radius: 16; -fx-border-color: #E5E7EB; -fx-border-radius: 16; -fx-padding: 24;">

                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;"
                               text="Información de Contacto y Domicilio"/>

                        <GridPane hgap="18.0" vgap="16.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                            </columnConstraints>

                            <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                                       text="Teléfono (E_tel)"/>
                                <TextField fx:id="txtTel" promptText="Ej. 2664422334"
                                           style="-fx-background-color: #F3F4F6; -fx-background-radius: 10; -fx-border-color: transparent; -fx-padding: 10 12 10 12; -fx-font-size: 13px;"/>
                            </VBox>

                            <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                                       text="Correo Electrónico (E_correo)"/>
                                <TextField fx:id="txtCorreo" promptText="empleado@empresa.com"
                                           style="-fx-background-color: #F3F4F6; -fx-background-radius: 10; -fx-border-color: transparent; -fx-padding: 10 12 10 12; -fx-font-size: 13px;"/>
                            </VBox>

                            <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1">
                                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                                       text="Dirección (E_dir)"/>
                                <TextField fx:id="txtDir" promptText="Calle, número y localidad (Ej. Av. Illia 123)"
                                           style="-fx-background-color: #F3F4F6; -fx-background-radius: 10; -fx-border-color: transparent; -fx-padding: 10 12 10 12; -fx-font-size: 13px;"/>
                            </VBox>
                        </GridPane>

                        <Region VBox.vgrow="ALWAYS"/>

                        <Button maxWidth="Infinity" onAction="#guardarEmpleado" prefHeight="44.0"
                                style="-fx-background-color: #262626; -fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;"
                                text="Guardar Empleado"/>
                    </VBox>
                </HBox>
            </VBox>

        </StackPane>
    </center>
</BorderPane>
