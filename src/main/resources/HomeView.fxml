<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane prefHeight="660.0" prefWidth="1120.0"
            style="-fx-background-color: #F3F4F6; -fx-font-family: 'Segoe UI', 'Inter', sans-serif;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controlador.HomeController">

    <!-- Región LEFT: Menú lateral con soporte para colapso / expansión compacta -->
    <left>
        <VBox fx:id="menuLateral" alignment="TOP_LEFT" prefWidth="225.0" spacing="8.0"
              style="-fx-background-color: #FFFFFF; -fx-border-color: #E5E7EB; -fx-border-width: 0 1 0 0;">
            <padding>
                <Insets bottom="24.0" left="16.0" right="16.0" top="20.0"/>
            </padding>

            <!-- Encabezado: Botón para esconder/mostrar todas las pestañas + Marca del Sistema -->
            <HBox fx:id="boxFilaSuperior" alignment="CENTER_LEFT" spacing="10.0">
                <!-- Botón arriba a la izquierda para esconder y mostrar todas las pestañas -->
                <Button fx:id="btnToggleMenu" onAction="#toggleMenuLateral"
                        prefHeight="38.0" prefWidth="38.0" minHeight="38.0" minWidth="38.0"
                        style="-fx-background-color: #F3F4F6; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 0; -fx-border-color: #E5E7EB; -fx-border-radius: 10;">
                    <tooltip>
                        <Tooltip fx:id="tooltipToggle" text="Ocultar menú lateral"/>
                    </tooltip>
                    <graphic>
                        <SVGPath fx:id="iconoToggleMenu"
                                 content="M3 5h18v2H3zm0 6h18v2H3zm0 6h18v2H3z"
                                 fill="#374151" scaleX="0.85" scaleY="0.85"/>
                    </graphic>
                </Button>

                <!-- Identidad visual / Logo del Sistema -->
                <HBox fx:id="boxMarca" alignment="CENTER_LEFT" spacing="10.0" HBox.hgrow="ALWAYS">
                    <VBox alignment="CENTER" maxHeight="38.0" maxWidth="38.0" minHeight="38.0" minWidth="38.0"
                          style="-fx-background-color: #F59E0B; -fx-background-radius: 10;">
                        <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold;" text="TPE"/>
                    </VBox>
                    <VBox spacing="1.0">
                        <Label style="-fx-text-fill: #111827; -fx-font-size: 15px; -fx-font-weight: bold;" text="Alquileres"/>
                        <Label style="-fx-text-fill: #6B7280; -fx-font-size: 10.5px;" text="Gestión de Flota"/>
                    </VBox>
                </HBox>
            </HBox>

            <Separator fx:id="sepEncabezado" style="-fx-padding: 8 0 6 0;"/>

            <!-- Botón destacado al inicio: + NUEVO (Generar Nuevo Contrato) -->
            <Button fx:id="btnNuevo" maxWidth="Infinity" onAction="#abrirPantallaNuevoContrato"
                    style="-fx-background-color: #111827; -fx-background-radius: 12; -fx-padding: 8 10 8 10; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;">
                <VBox.margin>
                    <Insets bottom="6.0"/>
                </VBox.margin>
                <effect>
                    <DropShadow color="#11182733" offsetY="3.0" radius="8.0"/>
                </effect>
                <tooltip>
                    <Tooltip text="Generar Nuevo Contrato"/>
                </tooltip>
                <graphic>
                    <HBox fx:id="boxContenidoNuevo" alignment="CENTER_LEFT" spacing="12.0">
                        <StackPane maxHeight="28.0" maxWidth="28.0" minHeight="28.0" minWidth="28.0"
                                   style="-fx-background-color: #F59E0B; -fx-background-radius: 8;">
                            <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 0 0 2 0;"
                                   text="+"/>
                        </StackPane>
                        <VBox fx:id="boxTextoNuevo" alignment="CENTER_LEFT" spacing="0.0">
                            <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 13.5px; -fx-font-weight: bold; -fx-letter-spacing: 0.5px;"
                                   text="NUEVO"/>
                            <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 10px;"
                                   text="Generar contrato"/>
                        </VBox>
                    </HBox>
                </graphic>
            </Button>

            <!-- Título de sección -->
            <Label fx:id="lblMenuPrincipal"
                   style="-fx-text-fill: #9CA3AF; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 4 0 4 8;"
                   text="MENÚ PRINCIPAL"/>

            <!-- Pestaña: Vehículos -->
            <Button fx:id="btnVehiculos" maxWidth="Infinity" onAction="#abrirPantallaVehiculos"
                    style="-fx-background-color: transparent; -fx-text-fill: #4B5563; -fx-font-size: 14px; -fx-font-weight: 600; -fx-alignment: CENTER_LEFT; -fx-padding: 10 12 10 12; -fx-background-radius: 10; -fx-cursor: hand;">
                <tooltip>
                    <Tooltip text="Vehículos"/>
                </tooltip>
                <graphic>
                    <HBox fx:id="boxVehiculos" alignment="CENTER_LEFT" spacing="12.0">
                        <StackPane alignment="CENTER" maxHeight="24.0" maxWidth="24.0" minHeight="24.0" minWidth="24.0">
                            <SVGPath fx:id="iconVehiculos"
                                     content="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"
                                     fill="#6B7280" scaleX="0.85" scaleY="0.85"/>
                        </StackPane>
                        <Label fx:id="lblVehiculos" style="-fx-text-fill: inherit; -fx-font-size: 13.5px; -fx-font-weight: inherit;" text="Vehículos"/>
                    </HBox>
                </graphic>
            </Button>

            <!-- Pestaña: Contratos -->
            <Button fx:id="btnContratos" maxWidth="Infinity" onAction="#abrirPantallaContratos"
                    style="-fx-background-color: transparent; -fx-text-fill: #4B5563; -fx-font-size: 14px; -fx-font-weight: 600; -fx-alignment: CENTER_LEFT; -fx-padding: 10 12 10 12; -fx-background-radius: 10; -fx-cursor: hand;">
                <tooltip>
                    <Tooltip text="Contratos"/>
                </tooltip>
                <graphic>
                    <HBox fx:id="boxContratos" alignment="CENTER_LEFT" spacing="12.0">
                        <StackPane alignment="CENTER" maxHeight="24.0" maxWidth="24.0" minHeight="24.0" minWidth="24.0">
                            <SVGPath fx:id="iconContratos"
                                     content="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"
                                     fill="#6B7280" scaleX="0.85" scaleY="0.85"/>
                        </StackPane>
                        <Label fx:id="lblContratos" style="-fx-text-fill: inherit; -fx-font-size: 13.5px; -fx-font-weight: inherit;" text="Contratos"/>
                    </HBox>
                </graphic>
            </Button>

            <!-- Pestaña: Clientes -->
            <Button fx:id="btnClientes" maxWidth="Infinity" onAction="#abrirPantallaClientes"
                    style="-fx-background-color: transparent; -fx-text-fill: #4B5563; -fx-font-size: 14px; -fx-font-weight: 600; -fx-alignment: CENTER_LEFT; -fx-padding: 10 12 10 12; -fx-background-radius: 10; -fx-cursor: hand;">
                <tooltip>
                    <Tooltip text="Clientes"/>
                </tooltip>
                <graphic>
                    <HBox fx:id="boxClientes" alignment="CENTER_LEFT" spacing="12.0">
                        <StackPane alignment="CENTER" maxHeight="24.0" maxWidth="24.0" minHeight="24.0" minWidth="24.0">
                            <SVGPath fx:id="iconClientes"
                                     content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                                     fill="#6B7280" scaleX="0.85" scaleY="0.85"/>
                        </StackPane>
                        <Label fx:id="lblClientes" style="-fx-text-fill: inherit; -fx-font-size: 13.5px; -fx-font-weight: inherit;" text="Clientes"/>
                    </HBox>
                </graphic>
            </Button>

            <!-- Pestaña: Empleados -->
            <Button fx:id="btnEmpleados" maxWidth="Infinity" onAction="#abrirPantallaEmpleados"
                    style="-fx-background-color: transparent; -fx-text-fill: #4B5563; -fx-font-size: 14px; -fx-font-weight: 600; -fx-alignment: CENTER_LEFT; -fx-padding: 10 12 10 12; -fx-background-radius: 10; -fx-cursor: hand;">
                <tooltip>
                    <Tooltip text="Empleados"/>
                </tooltip>
                <graphic>
                    <HBox fx:id="boxEmpleados" alignment="CENTER_LEFT" spacing="12.0">
                        <StackPane alignment="CENTER" maxHeight="24.0" maxWidth="24.0" minHeight="24.0" minWidth="24.0">
                            <SVGPath fx:id="iconEmpleados"
                                     content="M19 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm6 12H6v-1c0-2 4-3.1 6-3.1s6 1.1 6 3.1v1z"
                                     fill="#6B7280" scaleX="0.85" scaleY="0.85"/>
                        </StackPane>
                        <Label fx:id="lblEmpleados" style="-fx-text-fill: inherit; -fx-font-size: 13.5px; -fx-font-weight: inherit;" text="Empleados"/>
                    </HBox>
                </graphic>
            </Button>

            <!-- Pestaña: Sucursales -->
            <Button fx:id="btnSucursales" maxWidth="Infinity" onAction="#abrirPantallaSucursales"
                    style="-fx-background-color: transparent; -fx-text-fill: #4B5563; -fx-font-size: 14px; -fx-font-weight: 600; -fx-alignment: CENTER_LEFT; -fx-padding: 10 12 10 12; -fx-background-radius: 10; -fx-cursor: hand;">
                <tooltip>
                    <Tooltip text="Sucursales"/>
                </tooltip>
                <graphic>
                    <HBox fx:id="boxSucursales" alignment="CENTER_LEFT" spacing="12.0">
                        <StackPane alignment="CENTER" maxHeight="24.0" maxWidth="24.0" minHeight="24.0" minWidth="24.0">
                            <SVGPath fx:id="iconSucursales"
                                     content="M4 10v7h3v-7H4zm6 0v7h3v-7h-3zM2 22h19v-3H2v3zm14-12v7h3v-7h-3zm-5-7L2 8v1h19V8l-9-5z"
                                     fill="#6B7280" scaleX="0.85" scaleY="0.85"/>
                        </StackPane>
                        <Label fx:id="lblSucursales" style="-fx-text-fill: inherit; -fx-font-size: 13.5px; -fx-font-weight: inherit;" text="Sucursales"/>
                    </HBox>
                </graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Pie del menú lateral -->
            <VBox fx:id="boxFooterCompleto" spacing="2.0"
                  style="-fx-background-color: #F9FAFB; -fx-background-radius: 10; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-padding: 10 12 10 12;">
                <Label style="-fx-text-fill: #111827; -fx-font-size: 12px; -fx-font-weight: bold;" text="Base de Datos II"/>
                <Label style="-fx-text-fill: #6B7280; -fx-font-size: 11px;" text="Sistema TPE"/>
            </VBox>

            <VBox fx:id="boxFooterCompacto" alignment="CENTER" managed="false" maxHeight="32.0" maxWidth="32.0" minHeight="32.0" minWidth="32.0" visible="false"
                  style="-fx-background-color: #F9FAFB; -fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-radius: 8;">
                <Label style="-fx-text-fill: #6B7280; -fx-font-size: 10px; -fx-font-weight: bold;" text="BD2"/>
            </VBox>
        </VBox>
    </left>

    <!-- Región CENTER: HomeScreen inicialmente vacío hasta que el usuario seleccione una opción -->
    <center>
        <StackPane fx:id="panelCentral" style="-fx-background-color: #F3F4F6;"/>
    </center>

</BorderPane>
